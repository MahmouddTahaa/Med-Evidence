# Med-Evidence local secrets (do not commit real values)

# Embeddings (optional — frozen stack uses local Sentence Transformers)
OPENAI_API_KEY=

# Generation cascade (first available wins)
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OPENAI_API_KEY also used above for chat if set
# OpenRouter / other OpenAI-compatible chat hosts:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Local OpenAI-compatible server (Ollama, etc.) — skipped if unreachable
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=

# Optional generation defaults via nested settings (examples)
# GENERATION__WEAK_SCORE=0.35
# GENERATION__PROMPT_K=5
# GENERATION__MEMORY_TURNS=6
# GENERATION__GEMINI_MODEL=gemini-2.5-flash
# GENERATION__OPENAI_MODEL=gpt-4o-mini
